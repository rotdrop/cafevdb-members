{
  "use-cscope": null,
  "tag-dir": null,
  "filter": {
    "php-file-ext-list": [
      "php"
    ],
    "php-path-list": [
      ".",
      "../../3rdparty",
      "../../lib",
      "../cafevdb",
      "../groupfolders"
    ],
    "ignore-ruleset": [
      "# like .gitignore file ",
      "/vendor/**/[tT]ests/**/*.php",
      "/vendor/**/[Ee]xamples/**/*.php",
      "/vendor/composer/*.php",
      "/vendor/*.php",
      "/vendor-bin/cs-fixer/**",
      "/vendor-bin/phpcs/**",
      "/vendor-bin/phpmd/**",
      "# not need php_codesniffer",
      "/build/**",
      "/3rdparty/**",
      "/dev-scripts/playground/**",
      "#  -- end -- "
    ]
  }
}
