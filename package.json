{
  "name": "cafevdbmembers",
  "version": "0.0.4",
  "private": true,
  "description": "Expose a member's data record for the respective member",
  "homepage": "https://github.com/rotdrop/cafevdb-members.git",
  "bugs": {
    "url": "https://github.com/rotdrop/cafevdb-members.git"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rotdrop/cafevdb-members.git"
  },
  "license": "agpl",
  "author": "Claus-Justus Heine <himself@claus-justus-heine.de>",
  "scripts": {
    "build": "webpack --node-env production --progress",
    "dev": "webpack --node-env development --progress",
    "lint": "eslint --ext .js,.ts,.vue src",
    "lint:fix": "eslint --ext .js,.ts,.vue src --fix",
    "serve": "webpack --node-env development serve --progress",
    "watch": "webpack --node-env development --progress --watch"
  },
  "prettier": {
    "singleQuote": true,
    "plugins": [
      "@prettier/plugin-php"
    ],
    "overrides": [
      {
        "files": "*.php",
        "options": {
          "parser": "php"
        }
      }
    ]
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "eslintIgnore": [
    "src/toolkit/util/ajax.js",
    "src/toolkit/util/dialogs.js",
    "src/toolkit/util/file-download.js",
    "src/toolkit/util/jquery.js"
  ],
  "devDependencies": {
    "@babel/preset-typescript": "^7.28.5",
    "@nextcloud/auth": "^2.6.0",
    "@nextcloud/axios": "^2.6.0",
    "@nextcloud/babel-config": "^1.3.0",
    "@nextcloud/browserslist-config": "^3.1.2",
    "@nextcloud/dialogs": "^7.0.2",
    "@nextcloud/eslint-config": "^9.0.1",
    "@nextcloud/initial-state": "^3.0.0",
    "@nextcloud/l10n": "*",
    "@nextcloud/moment": "*",
    "@nextcloud/router": "*",
    "@nextcloud/vue": "^9.10.0",
    "@nextcloud/webpack-vue-config": "^7.0.3",
    "@prettier/plugin-php": "^0.25.0",
    "@rotdrop/nextcloud-vue-components": "file:3rdparty/rotdrop-nextcloud-vue-components",
    "@types/deep-equal": "^1.0.4",
    "@vue/tsconfig": "^0.9.1",
    "axios": "^1.19.0",
    "babel-loader-exclude-node-modules-except": "^1.2.4",
    "csso-webpack-plugin": "^3.0.0",
    "deep-equal": "^2.2.3",
    "eslint-webpack-plugin": "^6.0.0",
    "html-webpack-plugin": "^5.6.8",
    "js-md5": "^0.9.2",
    "material-icons": "^1.13.14",
    "mini-css-extract-plugin": "^2.10.2",
    "pinia": "^4.0.3",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "stacktrace-gps": "github:stacktracejs/stacktrace-gps#62f6967fc85e6fdd5fb9cea1a056b935d9b07a9a",
    "stacktrace-js": "^2.0.2",
    "svgo-loader": "^5.0.0",
    "typescript": "^6.0.0",
    "vue": "^3.5.41",
    "vue-material-design-icons": "^5.3.1",
    "vue-router": "^5.2.0",
    "walkjs": "^6.0.1",
    "webpack": "~5.106.2",
    "webpack-deadcode-plugin": "^0.1.17",
    "xml-loader": "^1.2.1",
    "xml2js": "*"
  },
  "engines": {
    "node": "^24.0.0",
    "npm": "^11.0.0"
  },
  "allowScripts": {
    "@nextcloud/webpack-vue-config@7.0.4": true,
    "@parcel/watcher@2.6.0": true,
    "core-js@3.50.0": true,
    "github:stacktracejs/stacktrace-gps#62f6967fc85e6fdd5fb9cea1a056b935d9b07a9a": true,
    "uuid@14.0.2": true
  }
}
